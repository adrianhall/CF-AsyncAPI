{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "async-api",
  "compatibility_date": "2026-04-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker/index.ts",

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },

  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "async-api-images"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "REPLACE_WITH_REAL_ID_AFTER_CREATE"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "async-api-db",
      "database_id": "REPLACE_WITH_REAL_ID_AFTER_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "queues": {
    "producers": [
      {
        "queue": "async-api-jobs",
        "binding": "JOB_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "async-api-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "async-api-dlq"
      }
    ]
  },

  "observability": {
    "enabled": true
  }
}
